<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="ContentApp">

  <Id>eedebb3c-650c-4687-8327-e3a97c7b0873</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Jude Savarraj</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Slide WebView"/>
  <Description DefaultValue="Show a live web page inside a PowerPoint slide. Free, self-hosted replacement for the subscription Web Viewer add-in. The target URL is stored in the document setting 'src'."/>

  <IconUrl DefaultValue="https://judepj.github.io/pptx-webview-proof/addin/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://judepj.github.io/pptx-webview-proof/addin/icon-64.png"/>
  <SupportUrl DefaultValue="https://github.com/judepj/pptx-webview-proof"/>

  <AppDomains>
    <AppDomain>https://judepj.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="Settings" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://judepj.github.io/pptx-webview-proof/addin/viewer.html"/>
    <RequestedWidth>960</RequestedWidth>
    <RequestedHeight>540</RequestedHeight>
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
